# ========= 複製這個檔案改名為 .env.local（本機）或貼到 Vercel 的 Environment Variables =========

# Supabase：Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=貼上 service_role 金鑰（絕對不能公開）

# Cloudflare Turnstile：下面兩個是 Cloudflare 官方「測試用」金鑰，永遠驗證通過
# 正式上線前，請換成你在 Cloudflare 後台建立的金鑰
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# 雜湊用的祕密字串：隨便打一長串亂碼（至少 32 字），上線後不要再改，改了等於所有人可以重投
VOTE_HASH_SALT=請換成一長串你自己打的亂碼

# 時程（台灣時間）。依《選罷法》第 51 條，投票日前 10 天起不得公布民調結果
RESULTS_BLACKOUT_START=2026-11-18T00:00:00+08:00
VOTING_CLOSES=2026-11-28T16:00:00+08:00

# 裝置指紋擋重複投票：true = 開啟。若大量 iPhone 使用者回報「沒投過卻說已投」，可改成 false
FINGERPRINT_BLOCKING=true
